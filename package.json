  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/camelcase-keys": "^4.1.0",
    "@types/lodash": "^4.17.19",
    "@types/node": "^24.0.3",
    "@types/papaparse": "^5.3.16",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
